        <mxCell id="indo_leg_1" value="• Entitas (Persegi): Objek utama data sistem (Pengguna, Anggota Keluarga, Permohonan Ubah Profil, Akta Kelahiran, Akta Kematian, dan Log Aktivitas)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#334155;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="960" width="1450" height="18" as="geometry" /></mxCell>
        <mxCell id="indo_leg_2" value="• Relasi (Belah Ketupat): Hubungan fungsional bisnis antar entitas (misal: Pengguna 'Memiliki' Anggota Keluarga, Pengguna 'Mengajukan' Akta Kelahiran)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#334155;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="978" width="1450" height="18" as="geometry" /></mxCell>
        <mxCell id="indo_leg_3" value="• Kardinalitas (1 : N): Satu akun pengguna dapat memiliki banyak anggota keluarga dan dapat mengajukan banyak permohonan akta. Garis tanpa perpotongan untuk kemudahan pemahaman." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#334155;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="996" width="1450" height="18" as="geometry" /></mxCell>

